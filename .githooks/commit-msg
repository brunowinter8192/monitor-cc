#!/usr/bin/env bash

set -u

MSG_FILE="$1"
EXPECTED_NAME="Bruno Winter"
EXPECTED_EMAIL="brunowinter8192@github.com"

fail() {
    echo "commit-msg hook: $1" >&2
    echo "  -> commit aborted. Fix and retry." >&2
    exit 1
}

if grep -qiE '^[[:space:]]*co-authored-by:' "$MSG_FILE"; then
    fail "Co-Authored-By trailer found ($(grep -icE '^[[:space:]]*co-authored-by:' "$MSG_FILE") line(s))"
fi
if grep -qiE '(generated with|🤖 generated|created with) .*(claude|copilot|cursor|codex)' "$MSG_FILE"; then
    fail "tool-attribution banner found in commit message"
fi

check_ident() {
    role="$1"; label="$2"
    ident="$(git var "GIT_${role}_IDENT" 2>/dev/null)" || return 0
    name="${ident%% <*}"
    email="${ident#*<}"; email="${email%%>*}"
    [ "$name" = "$EXPECTED_NAME" ] || fail "$label name is '$name', expected '$EXPECTED_NAME'"
    [ "$email" = "$EXPECTED_EMAIL" ] || fail "$label email is '$email', expected '$EXPECTED_EMAIL'"
}
check_ident AUTHOR author
check_ident COMMITTER committer

exit 0
